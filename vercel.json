{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/gallery.html",
      "destination": "/gallery/",
      "permanent": true
    },
    {
      "source": "/reviews.html",
      "destination": "/reviews/",
      "permanent": true
    },
    {
      "source": "/yard-clean-promise.html",
      "destination": "/yard-clean-promise/",
      "permanent": true
    },
    {
      "source": "/why-choose-us.html",
      "destination": "/why-choose-us/",
      "permanent": true
    },
    {
      "source": "/get-estimate.html",
      "destination": "/get-estimate/",
      "permanent": true
    },
    {
      "source": "/contact-us/",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/contact-us.html",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/services.html",
      "destination": "/services/",
      "permanent": true
    },
    {
      "source": "/estimate/",
      "destination": "/get-estimate/",
      "permanent": true
    },
    {
      "source": "/free-estimate/",
      "destination": "/get-estimate/",
      "permanent": true
    },
    {
      "source": "/hail/",
      "destination": "/hail-damage-roof-repair-lethbridge/",
      "permanent": true
    },
    {
      "source": "/hail-damage/",
      "destination": "/hail-damage-roof-repair-lethbridge/",
      "permanent": true
    },
    {
      "source": "/roof-repair/",
      "destination": "/roof-repair-lethbridge/",
      "permanent": true
    },
    {
      "source": "/roof-replacement/",
      "destination": "/roof-replacement-lethbridge/",
      "permanent": true
    },
    {
      "source": "/metal-roofing/",
      "destination": "/metal-roofing-lethbridge/",
      "permanent": true
    },
    {
      "source": "/gutters/",
      "destination": "/gutters-lethbridge/",
      "permanent": true
    },
    {
      "source": "/eavestrough/",
      "destination": "/gutters-lethbridge/",
      "permanent": true
    },
    {
      "source": "/eavestroughs/",
      "destination": "/gutters-lethbridge/",
      "permanent": true
    },
    {
      "source": "/coaldale/",
      "destination": "/service-areas/coaldale/",
      "permanent": true
    },
    {
      "source": "/claresholm/",
      "destination": "/service-areas/claresholm/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}