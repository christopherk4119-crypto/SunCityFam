---
import Base from '../layouts/Base.astro';
import { business } from '../config/business';
---
<Base title="Thank You | Sun City Roofing" description="Thanks for requesting a free estimate from Sun City Roofing." noindex>
  <section class="section bg-white">
    <div class="container-x max-w-2xl text-center">
      <h1 class="mb-4">Thanks — we've got your request.</h1>
      <p class="mb-8 text-xl">{business.owner} will call you shortly. Can't wait? Call <a href={business.phone.tel} data-loc="thank-you-copy" class="font-bold text-red-dark">{business.phone.display}</a> now.</p>
      <a href={business.phone.tel} data-loc="thank-you" class="btn btn-red !text-xl">📞 Call {business.phone.display}</a>
      <p class="mt-8"><a href="/" class="font-semibold text-red-dark">Back to home</a></p>
    </div>
  </section>
  <script is:inline>
    // GA4 conversion event — mark "generate_lead" as a key event in GA4 admin.
    (function fire(n){ if (typeof window.gtag === 'function') { window.gtag('event', 'generate_lead', { form_name: 'estimate' }); } else if (n < 20) { setTimeout(function(){ fire(n+1); }, 250); } })(0);
  </script>
</Base>
