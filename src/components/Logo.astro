---
// Real Sun City Roofing logo, cropped clean from the Facebook banner (227×269).
// TODO: ask Chris for the original high-res / vector logo and replace this file.
import { Image } from 'astro:assets';
import logo from '../assets/brand/sun-city-roofing-logo.png';
interface Props { class?: string; light?: boolean; eager?: boolean }
const { class: cls = 'h-12 w-auto', light = false, eager = true } = Astro.props;
---
{light
  ? <span class="inline-block rounded-lg bg-white p-2"><Image src={logo} alt="Sun City Roofing" height={96} densities={[1, 2]} class={cls} loading="lazy" /></span>
  : <Image src={logo} alt="Sun City Roofing — home" height={64} densities={[1, 2]} class={cls} loading={eager ? 'eager' : 'lazy'} />}
