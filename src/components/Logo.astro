---
// TODO: replace with the real Sun City Roofing logo file (SVG preferred) when supplied.
interface Props { class?: string; light?: boolean }
const { class: cls = 'h-10 w-auto', light = false } = Astro.props;
const text = light ? '#ffffff' : '#111827';
---
<svg class={cls} viewBox="0 0 220 48" role="img" aria-label="Sun City Roofing — home">
  <circle cx="24" cy="22" r="9" fill="#DC2626" />
  <g stroke="#DC2626" stroke-width="2.5" stroke-linecap="round">
    <line x1="24" y1="4" x2="24" y2="8" /><line x1="9" y1="10" x2="12" y2="13" /><line x1="39" y1="10" x2="36" y2="13" />
  </g>
  <path d="M4 40 L24 26 L44 40" fill="none" stroke={text} stroke-width="4" stroke-linejoin="round" stroke-linecap="round" />
  <text x="54" y="24" font-family="Outfit, sans-serif" font-weight="800" font-size="20" fill={text}>SUN CITY</text>
  <text x="54" y="42" font-family="Outfit, sans-serif" font-weight="700" font-size="14" letter-spacing="3.2" fill="#DC2626">ROOFING</text>
</svg>
