---
import Icon from './Icon.astro';
import { business, widerArea } from '../config/business';
const items = [
  { icon: 'clock', text: '20+ yrs experience' },
  ...(business.licensedInsured ? [{ icon: 'shield', text: 'Licensed & Insured' }] : []),
  { icon: 'tag', text: 'Best-Price Guarantee' },
  { icon: 'broom', text: 'Yard-Clean Promise' },
  { icon: 'pin', text: `Lethbridge & ${widerArea}` },
];
---
<div class="border-y border-gray-200 bg-gray-50">
  <ul class="container-x grid grid-cols-2 gap-x-4 gap-y-3 py-5 text-sm font-semibold text-ink sm:text-base md:flex md:justify-between">
    {items.map((i) => (<li class="flex items-center gap-2"><Icon name={i.icon} class="h-5 w-5 shrink-0 text-red" />{i.text}</li>))}
  </ul>
</div>
