---
import { business } from '../config/business';
interface Props { text?: string; tint?: boolean }
const { text = 'Want a straight answer on your roof?', tint = true } = Astro.props;
---
<div class:list={['py-8', tint ? 'bg-red-50' : 'bg-white']}>
  <div class="container-x flex flex-col items-center justify-between gap-4 rounded-xl border border-red-200 bg-white p-6 text-center shadow-sm md:flex-row md:text-left">
    <p class="font-heading text-xl font-bold text-ink">{text} <span class="block text-base font-medium text-muted">Call {business.phone.display}. {business.hours.copy}</span></p>
    <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
      <a href={business.phone.tel} data-loc="cta-inline" class="btn btn-red">Call {business.phone.display}</a>
      <a href="/get-estimate/" class="btn btn-outline">Free Estimate</a>
    </div>
  </div>
</div>
