---
// Accessible FAQ using <details>. Pair with faqSchema() in the page's JSON-LD (same q/a text).
interface Props { faqs: { q: string; a: string }[]; title?: string; id?: string }
const { faqs, title = 'Frequently Asked Questions', id = 'faq' } = Astro.props;
---
<section id={id} class="section bg-gray-50">
  <div class="container-x max-w-3xl">
    <h2 class="mb-8 text-center">{title}</h2>
    <div class="space-y-3">
      {faqs.map((f) => (
        <details class="group rounded-xl border border-gray-200 bg-white p-5 open:shadow-sm">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-heading text-lg font-bold text-ink [&::-webkit-details-marker]:hidden">
            {f.q}
            <span class="mt-1 text-2xl leading-none text-red-dark transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 text-ink-soft">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
