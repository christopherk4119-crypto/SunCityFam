---
import { business } from '../config/business';
interface Props { author: string; quote: string; truncated?: boolean; tags?: string[]; class?: string }
const { author, quote, truncated = false, tags = [], class: cls = '' } = Astro.props;
---
<figure class:list={['flex h-full flex-col rounded-xl border border-gray-200 bg-white p-6 shadow-sm', cls]}>
  <blockquote class="flex-1 text-ink-soft">
    <p>{quote}</p>
  </blockquote>
  {truncated && business.social.googleReviewsUrl && (
    <a href={business.social.googleReviewsUrl} target="_blank" rel="noopener" class="mt-2 text-sm font-semibold text-red-dark">Read the full review on Google</a>
  )}
  <figcaption class="mt-4 flex flex-wrap items-center gap-2 border-t border-gray-100 pt-4">
    <span class="font-heading font-bold text-ink">— {author}</span>
    <span class="text-sm text-muted">Google review</span>
    {tags.map((t) => <span class="rounded-full bg-red-50 px-2.5 py-0.5 text-xs font-semibold text-red-dark">{t}</span>)}
  </figcaption>
</figure>
