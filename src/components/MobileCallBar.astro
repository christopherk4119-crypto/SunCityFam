---
import { business } from '../config/business';
---
<div class="fixed inset-x-0 bottom-0 z-50 flex gap-2 border-t border-red-200 bg-white p-2 shadow-[0_-4px_16px_rgba(0,0,0,0.08)] md:hidden" style="padding-bottom: max(0.5rem, env(safe-area-inset-bottom));">
  <a href={business.phone.tel} data-loc="sticky-bar" class="btn btn-red min-w-0 flex-[7] flex-col !gap-0 !px-2 !py-1.5 leading-tight">
    <span class="text-sm font-semibold">📞 Call Now</span>
    <span class="whitespace-nowrap text-lg">{business.phone.display}</span>
  </a>
  <a href="/get-estimate/" class="btn btn-outline min-w-0 flex-[4] !px-2 !text-base leading-tight">Free Estimate</a>
</div>
