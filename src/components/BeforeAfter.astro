---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { before: ImageMetadata; after: ImageMetadata; beforeAlt: string; afterAlt: string; caption?: string }
const { before, after, beforeAlt, afterAlt, caption } = Astro.props;
const b = await getImage({ src: before, width: 1200, format: 'webp', quality: 60 });
const a = await getImage({ src: after, width: 1200, format: 'webp', quality: 60 });
const ratio = `${after.width} / ${after.height}`;
---
<figure class="ba">
  <div class="ba-frame relative w-full overflow-hidden rounded-xl bg-gray-100" style={`aspect-ratio:${ratio}`}>
    <img src={a.src} alt={afterAlt} width={after.width} height={after.height} loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover" />
    <div class="ba-before absolute inset-0" style="clip-path: inset(0 50% 0 0)">
      <img src={b.src} alt={beforeAlt} width={before.width} height={before.height} loading="lazy" decoding="async" class="h-full w-full object-cover" />
    </div>
    <div class="ba-line pointer-events-none absolute inset-y-0 left-1/2 w-1 -translate-x-1/2 bg-white shadow"></div>
    <span class="absolute top-3 left-3 rounded bg-ink/80 px-2 py-1 text-xs font-bold text-white">Before</span>
    <span class="absolute top-3 right-3 rounded bg-red-dark px-2 py-1 text-xs font-bold text-white">After</span>
    <input type="range" min="0" max="100" value="50" aria-label="Drag to compare before and after" class="ba-range absolute inset-0 h-full w-full cursor-ew-resize opacity-0" />
  </div>
  {caption && <figcaption class="mt-2 text-sm font-medium text-muted">{caption}</figcaption>}
</figure>
<script>
  document.querySelectorAll<HTMLElement>('.ba').forEach((el) => {
    const range = el.querySelector<HTMLInputElement>('.ba-range');
    const before = el.querySelector<HTMLElement>('.ba-before');
    const line = el.querySelector<HTMLElement>('.ba-line');
    range?.addEventListener('input', () => {
      const v = Number(range.value);
      if (before) before.style.clipPath = `inset(0 ${100 - v}% 0 0)`;
      if (line) line.style.left = `${v}%`;
    });
  });
</script>
