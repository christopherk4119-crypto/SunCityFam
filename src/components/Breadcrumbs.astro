---
interface Props { items: { name: string; path: string }[] }
const { items } = Astro.props;
---
<nav aria-label="Breadcrumb" class="border-b border-gray-100 bg-gray-50">
  <ol class="container-x flex flex-wrap items-center gap-1.5 py-2.5 text-sm text-muted">
    {items.map((it, i) => (
      <li class="flex items-center gap-1.5">
        {i > 0 && <span aria-hidden="true">/</span>}
        {i === items.length - 1
          ? <span aria-current="page" class="font-medium text-ink">{it.name}</span>
          : <a href={it.path} class="hover:text-red-dark">{it.name}</a>}
      </li>
    ))}
  </ol>
</nav>
