---
/**
 * Estimate form → Formspree (set business.formEndpoint). Submits with fetch so the visitor
 * lands on our own /thank-you/ page (which fires the GA4 conversion), and falls back to a
 * normal POST if JavaScript is off. With no endpoint set, a call/text box is shown instead,
 * so a lead is never silently lost.
 */
import { business, services } from '../config/business';
interface Props { id?: string; compact?: boolean; heading?: string }
const { id = 'estimate', compact = false, heading = 'Get My Free Estimate' } = Astro.props;
const endpoint = business.formEndpoint;
const field = 'mt-1 block w-full rounded-lg border border-gray-300 bg-white px-3.5 py-3 text-base text-ink shadow-sm focus:border-ink focus:outline-none focus:ring-2 focus:ring-ink';
const label = 'block font-semibold text-ink';
---
{!endpoint ? (
  <div id={id} class="rounded-2xl border border-gray-200 bg-white p-6 text-left shadow-lg sm:p-8">
    <h2 class="mb-2 text-2xl sm:text-3xl">Get Your Free Estimate</h2>
    <p class="mb-6 text-lg">Call or text {business.owner}. We answer any time.</p>
    <div class="flex flex-col gap-3">
      <a href={business.phone.tel} data-loc="form-fallback" class="btn btn-red !text-xl">📞 Call {business.phone.display}</a>
      <a href={business.phone.sms} data-loc="form-fallback-sms" class="btn btn-outline">💬 Text us a photo of your roof</a>
      <a href={`mailto:${business.email}?subject=Free%20roofing%20estimate`} class="text-center font-semibold text-red-dark">or email {business.email}</a>
    </div>
  </div>
) : (
<form
  id={id}
  method="POST"
  action={endpoint}
  data-estimate-form
  class="rounded-2xl border border-gray-200 bg-white p-5 text-left shadow-lg sm:p-7"
>
  <input type="hidden" name="_subject" value="New estimate request — suncityroofinglethbridge.net" />
  <p class="hidden"><label>Leave this empty: <input name="_gotcha" tabindex="-1" autocomplete="off" /></label></p>

  <h2 class="mb-1 text-2xl sm:text-3xl">{heading}</h2>
  <p class="mb-5 text-muted">Free, no obligation. Prefer to talk? <a href={business.phone.tel} data-loc="form" class="font-semibold text-red-dark">{business.phone.display}</a></p>

  <div class:list={['grid gap-4', !compact && 'sm:grid-cols-2']}>
    <div>
      <label for={`${id}-name`} class={label}>Name</label>
      <input id={`${id}-name`} name="name" type="text" autocomplete="name" required class={field} />
    </div>
    <div>
      <label for={`${id}-phone`} class={label}>Phone</label>
      <input id={`${id}-phone`} name="phone" type="tel" autocomplete="tel" inputmode="tel" required class={field} />
    </div>
    <div class:list={[!compact && 'sm:col-span-2']}>
      <label for={`${id}-address`} class={label}>Address or town</label>
      <input id={`${id}-address`} name="address" type="text" autocomplete="street-address" required placeholder="e.g. 123 Main St, Lethbridge" class={field} />
    </div>
    <div>
      <label for={`${id}-service`} class={label}>What do you need?</label>
      <select id={`${id}-service`} name="service" required class={field}>
        <option value="">Choose one…</option>
        {services.map((s) => <option>{s.name}</option>)}
        <option>Not sure — need an inspection</option>
      </select>
    </div>
    <fieldset>
      <legend class={label}>Is this an insurance / hail claim?</legend>
      <div class="mt-2 flex flex-wrap gap-2">
        {['Yes', 'No', 'Not sure'].map((v, i) => (
          <label class="flex min-h-[44px] cursor-pointer items-center gap-2 rounded-lg border border-gray-300 px-3 py-2 has-[:checked]:border-ink has-[:checked]:bg-gray-50">
            <input type="radio" name="insurance_claim" value={v} required={i === 0} class="h-4 w-4 accent-[#B91C1C]" /> {v}
          </label>
        ))}
      </div>
    </fieldset>
    <div class:list={[!compact && 'sm:col-span-2']}>
      <label for={`${id}-message`} class={label}>Anything else? <span class="font-normal text-muted">(optional)</span></label>
      <textarea id={`${id}-message`} name="message" rows="3" class={field}></textarea>
    </div>
  </div>

  <button type="submit" class="btn btn-red mt-6 w-full !text-xl">Get My Free Estimate</button>
  <p class="mt-3 text-center text-sm text-muted">We only use your info to contact you about your roof. <a href="/privacy/" class="underline">Privacy policy</a>.</p>
</form>
)}

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-estimate-form]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        window.location.href = '/thank-you/';
      } catch {
        if (btn) { btn.disabled = false; btn.textContent = 'Get My Free Estimate'; }
        alert('Sorry — that didn\'t send. Please call or text us at (403) 929-5588.');
      }
    });
  });
</script>
